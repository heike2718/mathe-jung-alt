# 4) Backend – Format + schneller Lint
if echo "$STAGED" | grep -qE '\.java$'; then
  echo "☕ sort and format (backend)"
  (cd $BACKEND_DIR && mvn -Pformat-apply impsort:sort@impsort-sort formatter:format@format-apply)
  git ls-files -m | grep -E '\.java$' | xargs -r git add

