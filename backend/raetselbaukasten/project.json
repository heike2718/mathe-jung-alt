{
  "name": "raetselbaukasten-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "backend/raetselbaukasten/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/raetselbaukasten",
        "command": "mvn -DskipTests package"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/raetselbaukasten",
        "command": "mvn test"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/raetselbaukasten",
        "command": "mvn quarkus:dev"
      }
    }
  }
}
