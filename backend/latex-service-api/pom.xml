<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>de.egladil.web</groupId>
	<artifactId>latex-service-api</artifactId>
	<version>2.0.0</version>
	<packaging>jar</packaging>

	<name>latex-client</name>
	<description>lightweight API to convert LaTeX into pdf or png</description>


	<properties>
		<undertow.version>2.3.18.Final</undertow.version>
		<jackson.version>2.18.2</jackson.version>
		<slf4j.version>1.7.33</slf4j.version>
		<junit.version>5.8.2</junit.version>
		<mockito.version>4.4.0</mockito.version>
		<logback.version>1.3.0-beta0</logback.version>
		<compiler-plugin.version>3.13.0</compiler-plugin.version>

		<!-- Start mixin-properties -->
		<pmd.failOnViolation>false</pmd.failOnViolation>
		<spotbugs.failOnError>false</spotbugs.failOnError>

		<dependency-check.version>12.2.0</dependency-check.version>

		<mixin-maven-plugin.version>1.0.6</mixin-maven-plugin.version>
		<egladil-maven-mixins.version>1.0.0</egladil-maven-mixins.version>
		<!-- Ende mixin-propetries -->

		<maven.compiler.release>21</maven.compiler.release>
		<maven.compiler.parameters>true</maven.compiler.parameters>

	</properties>

	<dependencies>
		<dependency>
			<groupId>io.undertow</groupId>
			<artifactId>undertow-core</artifactId>
			<version>${undertow.version}</version>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.version}</version>
		</dependency>

		<dependency>
			<groupId>org.jboss.logging</groupId>
			<artifactId>jboss-logging</artifactId>
			<version>3.5.3.Final</version>
		</dependency>

		<!-- Test START -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.16.1</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.jboss.logmanager</groupId>
			<artifactId>jboss-logmanager</artifactId>
			<version>3.0.2.Final</version>
			<scope>test</scope>
		</dependency>

		<!-- Test ENDE -->

	</dependencies>

	<build>

		<finalName>${project.artifactId}</finalName>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>2.4.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<manifestEntries>
										<Main-Class>
											de.egladil.web.latex_service.LaTeXServiceApplication</Main-Class>
										<Build-Number>${project.version}</Build-Number>
									</manifestEntries>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.playtika.maven.plugins</groupId>
				<artifactId>mixin-maven-plugin</artifactId>
				<version>${mixin-maven-plugin.version}</version>
				<extensions>true</extensions>
				<configuration>
					<mixins>
						<mixin>
							<groupId>de.egladil</groupId>
							<artifactId>java-core-mixin</artifactId>
							<version>${egladil-maven-mixins.version}</version>
						</mixin>
						<mixin>
							<groupId>de.egladil</groupId>
							<artifactId>java-linting-mixin</artifactId>
							<version>${egladil-maven-mixins.version}</version>
						</mixin>
						<mixin>
							<groupId>de.egladil</groupId>
							<artifactId>java-code-quality-mixin</artifactId>
							<version>${egladil-maven-mixins.version}</version>
						</mixin>
						<mixin>
							<groupId>de.egladil</groupId>
							<artifactId>java-unittestcoverage-mixin</artifactId>
							<version>${egladil-maven-mixins.version}</version>
						</mixin>
						<mixin>
							<groupId>de.egladil</groupId>
							<artifactId>java-security-mixin</artifactId>
							<version>${egladil-maven-mixins.version}</version>
						</mixin>
					</mixins>
				</configuration>
			</plugin>


			<plugin>
				<groupId>com.rudikershaw.gitbuildhook</groupId>
				<artifactId>git-build-hook-maven-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<gitConfig>
						<!-- The location of the directory you are using to store the Git hooks in
						your project. -->
						<core.hooksPath>.git-hooks/</core.hooksPath>
						<core.autoclrf>false</core.autoclrf>
						<core.eol>lf</core.eol>
						<core.safecrlf>true</core.safecrlf>
						<!-- Some other project specific git config that you want to set. -->
						<custom.configuration>true</custom.configuration>
					</gitConfig>
				</configuration>
				<executions>
					<execution>
						<goals>
							<!-- Sets git config specified under configuration > gitConfig. -->
							<goal>configure</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>
</project>