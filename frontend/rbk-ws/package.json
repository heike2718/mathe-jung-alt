  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "nx serve",
    "build:local": "npx nx build raetselbaukasten -c local --output-hashing=all --base-href /raetselbaukasten/ --skip-nx-cache",
    "build:heikeqs": "npx nx build raetselbaukasten -c heikeqs --output-hashing=all --base-href /raetselbaukasten/ --skip-nx-cache",
    "build:prod": "npx nx run raetselbaukasten:build:production --output-hashing=all --base-href /raetselbaukasten/ --skip-nx-cache",
    "test": "npx nx test",
    "test:all": "npx nx run-many --target=test --all",
    "lint:all": "npx nx run-many --target=lint --all",
    "full-check": "npx nx run-s lint:all test:all build",
    "graph": "npx nx graph"
  },
