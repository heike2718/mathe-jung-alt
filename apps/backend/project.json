{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "backend/raetselbaukasten",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn -f backend/raetselbaukasten/pom.xml -DskipTests package"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn -f backend/raetselbaukasten/pom.xml test"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn -f backend/raetselbaukasten/pom.xml quarkus:dev"
      }
    }
  }
}
