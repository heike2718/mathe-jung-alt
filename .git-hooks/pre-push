#!/usr/bin/env sh
set -e

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

FRONTEND_DIR="frontend/rbk-ws"
BACKEND_DIR="backend/raetselbaukasten"

echo "🚀 Running comprehensive pre-push checks..."

# FRONTEND: Build + Tests mit Vitest Coverage
if [ -d "$FRONTEND_DIR" ]; then
  echo "🔬 Frontend: running build..."
  cd "$FRONTEND_DIR" || exit 1
  nvm use 22 || exit 1
  npm run build:local
  
  echo "📊 Running frontend tests with Vitest coverage..."
  npm run test:ci
fi

# BACKEND: verify (Tests + Quality Gates)
if [ -d "$BACKEND_DIR" ]; then
  echo "☕ Backend: mvn verify (tests + quality gates)"
  (cd "$BACKEND_DIR" && mvn -q verify)
fi

echo "✅ All pre-push checks passed!"
exit 0