#!/usr/bin/env sh
set -e

FRONTEND_DIR="frontend/rbk-ws"
BACKEND_RBK_DIR="backend/raetselbaukasten"
BACKEND_LATEX_DIR="backend/latex-service-api"

# 1) Gestagte Dateien (nur Added/Copied/Modified)
STAGED="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$STAGED" ] && exit 0

# Hilfsfunktion: prüft, ob gestagte Dateien ein Pattern matchen
has_staged() {
  printf '%s\n' "$STAGED" | grep -E "$1" >/dev/null 2>&1
}

# Helper: stage exakt die Java-Dateien, die staged waren und unter einem Projektpfad liegen
stage_project_java() {
  # $1 = project path prefix (z.B. backend/raetselbaukasten)
  printf '%s\n' "$STAGED" \
    | grep -E "^$1/.*\.java$" \
    | xargs -r git add
}

# Helper: stage exakt die Frontend-Dateien, die staged waren
stage_frontend_files() {
  printf '%s\n' "$STAGED" \
    | grep -E "^$FRONTEND_DIR/.*\.(html|js|ts|jsx|tsx|css|scss|json|md|yml|yaml)$" \
    | xargs -r git add
}

# --- FRONTEND: staged format (prettier) -> staged lint fix (eslint) -> project lint (nx) ---

FRONTEND_STAGED="$(printf '%s\n' "$STAGED" \
  | grep -E "^$FRONTEND_DIR/.*\.(html|js|ts|jsx|tsx|css|scss|json|md|yml|yaml)$" || true)"

# Pfade relativ zum Frontend-Workspace, damit prettier/eslint sie versteht
FRONTEND_STAGED_REL="$(printf '%s\n' "$FRONTEND_STAGED" | sed "s#^$FRONTEND_DIR/##")"

if [ -n "$FRONTEND_STAGED_REL" ]; then
  echo "🎨 prettier --write (frontend staged)"
  (cd "$FRONTEND_DIR" && npx prettier --write $FRONTEND_STAGED_REL)
  stage_frontend_files

  echo "🔧 eslint --fix (frontend staged)"
  # eslint soll nur die staged files anfassen
  (cd "$FRONTEND_DIR" && npx eslint --fix $FRONTEND_STAGED_REL)
  stage_frontend_files

  echo "🔎 nx affected -t lint (frontend projektweit)"
  # Nx erwartet --files relativ zum WorkspaceRoot (= FRONTEND_DIR)
  FRONTEND_STAGED_CSV="$(printf '%s\n' "$FRONTEND_STAGED_REL" | paste -sd, -)"
  (cd "$FRONTEND_DIR" && npx nx affected -t lint --files="$FRONTEND_STAGED_CSV" --parallel=3)
fi

# --- BACKEND: Formatierung nur wenn staged Java im jeweiligen Projekt liegt ---

if has_staged '^backend/raetselbaukasten/.*\.java$'; then
  echo "☕ sort and format (backend/raetselbaukasten)"
  (cd "$BACKEND_RBK_DIR" && mvn -Pformat-apply impsort:sort@impsort-sort formatter:format@format-apply)
  stage_project_java "backend/raetselbaukasten"
fi

if has_staged '^backend/latex-service-api/.*\.java$'; then
  echo "☕ sort and format (backend/latex-service-api)"
  (cd "$BACKEND_LATEX_DIR" && mvn -Pformat-apply impsort:sort@impsort-sort formatter:format@format-apply)
  stage_project_java "backend/latex-service-api"
fi

exit 0