#!/usr/bin/env sh
set -e

FRONTEND_DIR="frontend/rbk-ws"
BACKEND_RBK_DIR="backend/raetselbaukasten"
BACKEND_LATEX_DIR="backend/latex-service-api"

# 1) Gestagte Dateien
STAGED="$(git diff --cached --name-only --diff-filter=ACM || true)"
[ -z "$STAGED" ] && exit 0

# Hilfsfunktion: prüft, ob gestagte Dateien ein Pattern matchen
has_staged() {
  echo "$STAGED" | grep -E "$1" >/dev/null 2>&1
}

# CSV-Liste für Nx (kommagetrennt)
STAGED_CSV="$(printf '%s\n' "$STAGED" | paste -sd, -)"

# Helper: stage exakt die Java-Dateien, die staged waren und unter einem Projektpfad liegen
stage_project_java() {
  # $1 = project path prefix (z.B. backend/raetselbaukasten)
  printf '%s\n' "$STAGED" \
    | grep -E "^$1/.*\.java$" \
    | xargs -r git add
}

